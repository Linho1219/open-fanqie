{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@openfanqie/core": ["../core/src/index.ts"],
      "@openfanqie/export-jpg": ["../export-jpg/src/index.ts"],
      "@openfanqie/export-pdf": ["../export-pdf/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
