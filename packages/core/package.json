{
  "name": "@openfanqie/core",
  "version": "0.1.0",
  "description": "A TypeScript renderer for the Fanqie numbered-notation DSL",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/open-fanqie-core.cjs",
  "module": "./dist/open-fanqie-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/open-fanqie-core.js",
      "require": "./dist/open-fanqie-core.cjs"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "rimraf dist coverage",
    "glyphs:extract": "node scripts/extract-glyphs.mjs",
    "legacy:compare": "pnpm run build && node scripts/compare-legacy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "jianpu",
    "numbered-notation",
    "svg",
    "fanqie"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
